{
  "_comment": "Golden parity fixtures for the documents skill's expansion layer — the analogue of expansion_cases.json, where the rendered artefact is the set of OUTPUT PATHS a plan produces rather than an ffmpeg argv (documents' preview returns paths). Fixed plans in, output basenames out, no model involved. Consumed by python/core/tests/test_documents_expansion_parity.py. WHY: `run` dispatches documents steps through the same loop as ffmpeg, which until 2026-08-10 executed only the first step of a plan (steps.first()). The corpus has seven multi-step documents rows, so the skill was exposed to exactly the same defect; the multi-step cases here are the regression. `rejected_cases` are plans both runtimes must refuse in a dry run, with an error containing `expected_error`, before producing any output: a dry run must not promise an output that execution would refuse (documents_105, 2026-10-03: native's dry run accepted a reorder_pages order that its execution rejected). A step that writes many files (a split) gives the number its case makes in `output_count`; every other case makes one output per step.",
  "sandbox": "contracts/parity/fixtures/documents",
  "cases": [
    {
      "name": "single_step_compress",
      "plan": {
        "plan": [
          {
            "tool": "compress_pdf",
            "args": {
              "input": "sample.pdf",
              "compress_quality": "balanced"
            }
          }
        ]
      },
      "expected_outputs": [
        "sample-compressed.pdf"
      ]
    },
    {
      "name": "two_step_rotate_then_compress",
      "plan": {
        "plan": [
          {
            "tool": "rotate_pages",
            "args": {
              "input": "sample.pdf",
              "degrees": 90,
              "output": "sample_rot.pdf"
            }
          },
          {
            "tool": "compress_pdf",
            "args": {
              "input": "sample_rot.pdf",
              "compress_quality": "balanced"
            }
          }
        ]
      },
      "expected_outputs": [
        "sample_rot.pdf",
        "sample_rot-compressed.pdf"
      ]
    },
    {
      "name": "two_step_watermark_then_compress",
      "plan": {
        "plan": [
          {
            "tool": "watermark",
            "args": {
              "input": "sample.pdf",
              "text": "CONFIDENTIAL",
              "output": "sample_wm.pdf"
            }
          },
          {
            "tool": "compress_pdf",
            "args": {
              "input": "sample_wm.pdf",
              "compress_quality": "balanced"
            }
          }
        ]
      },
      "expected_outputs": [
        "sample_wm.pdf",
        "sample_wm-compressed.pdf"
      ]
    },
    {
      "name": "two_step_remove_pages_then_numbers",
      "plan": {
        "plan": [
          {
            "tool": "remove_pages",
            "args": {
              "input": "sample.pdf",
              "pages": "1",
              "output": "sample_trimmed.pdf"
            }
          },
          {
            "tool": "add_page_numbers",
            "args": {
              "input": "sample_trimmed.pdf",
              "position": "bottom-center",
              "start_at": 1
            }
          }
        ]
      },
      "expected_outputs": [
        "sample_trimmed.pdf",
        "sample_trimmed-numbered.pdf"
      ]
    },
    {
      "name": "single_step_reorder_reverse",
      "plan": {
        "plan": [
          {
            "tool": "reorder_pages",
            "args": {
              "input": "sample.pdf",
              "order": "reverse"
            }
          }
        ]
      },
      "expected_outputs": [
        "sample-reordered.pdf"
      ]
    },
    {
      "name": "split_every_page",
      "plan": {
        "plan": [
          {
            "tool": "split_pdf_every",
            "args": {
              "input": "sample.pdf",
              "every": 1
            }
          }
        ]
      },
      "expected_outputs": [
        "sample-pages-1.pdf",
        "sample-pages-2.pdf",
        "sample-pages-3.pdf"
      ],
      "output_count": 3
    },
    {
      "name": "split_every_two_pages",
      "plan": {
        "plan": [
          {
            "tool": "split_pdf_every",
            "args": {
              "input": "sample.pdf",
              "every": 2
            }
          }
        ]
      },
      "expected_outputs": [
        "sample-pages-1_2.pdf",
        "sample-pages-3.pdf"
      ],
      "output_count": 2
    },
    {
      "name": "split_named_by_a_pattern",
      "plan": {
        "plan": [
          {
            "tool": "split_pdf",
            "args": {
              "input": "sample.pdf",
              "ranges": "1,2",
              "output": "part_%s.pdf"
            }
          }
        ]
      },
      "expected_outputs": [
        "part_1.pdf",
        "part_2.pdf"
      ],
      "output_count": 2
    }
  ],
  "rejected_cases": [
    {
      "name": "reorder_unparseable_order",
      "plan": {
        "plan": [
          {
            "tool": "reorder_pages",
            "args": {
              "input": "sample.pdf",
              "order": "original"
            }
          }
        ]
      },
      "expected_error": "Unrecognized page reference"
    },
    {
      "name": "reorder_no_valid_pages",
      "plan": {
        "plan": [
          {
            "tool": "reorder_pages",
            "args": {
              "input": "sample.pdf",
              "order": "9,10"
            }
          }
        ]
      },
      "expected_error": "has no valid pages"
    }
  ]
}
