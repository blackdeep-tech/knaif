      "name": "an invented folder on a chain reads as here",
      "utterance": "convert the .mov videos here to mp4, then shrink them",
      "dirs": [],
      "plan": [
        {
          "tool": "convert_video",
          "args": {
            "inputs": [
              "videos/*.mov"
            ],
            "container": "mp4",
            "output": "videos/*.mp4"
          }
        },
        {
          "tool": "compress_video",
          "args": {
            "inputs": [
              "videos/*.mp4"
            ]
          }
        }
      ],
      "expected": [
        {
          "tool": "convert_video",
          "args": {
            "inputs": [
              "*.mov"
            ],
            "container": "mp4",
            "output": "*.mp4"
          }
        },
        {
          "tool": "compress_video",
          "args": {
            "inputs": [
              "*.mp4"
            ]
          }
        }
      ]
