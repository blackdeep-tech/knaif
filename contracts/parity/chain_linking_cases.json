{
  "_comment": "Golden parity fixtures for chain linking — the stage that rewrites the model's plan in place BEFORE validation, binding a chain's intermediate files. Consumed by BOTH python/core/tests/test_chain_linking_parity.py and the Rust knaif-core tests/chain_linking_parity.rs; both must produce the identical linked plan. Covers both passes: claiming an undeclared intermediate, and forward-threading a reused source onto the producer's output. WHY: native shipped only the first pass until 2026-08-10, so 'trim clip.mp4, compress it, and remove the audio' built the silent video from the UNCOMPRESSED trim and discarded the compression — a wrong artefact that every plan-envelope comparison scored as a match. Registries are inline tools.yaml text so parity is on an identical registry, independent of skill content.",
  "registries": {
    "demo": "trim_video:\n  description: Trim a video to a time range\n  required_args: [input]\n  optional_args: [start, end, output]\ncompress_video:\n  description: Compress a video\n  required_args: [input]\n  optional_args: [output]\nstrip_audio:\n  description: Remove the audio track\n  required_args: [input]\n  optional_args: [output]\ninspect_media:\n  description: Report media properties\n  required_args: [input]\nmerge_videos:\n  description: Concatenate several videos\n  required_args: [inputs]\n  optional_args: [output]\nbatch_convert:\n  description: Convert every matching file\n  required_args: [pattern]\n  optional_args: [output]\ntag_media:\n  description: Write metadata tags\n  required_args: [input]\n  optional_args: [title]\n  arg_schemas:\n    output: {type: string}\n"
  },
  "expected_output_capable": {
    "demo": [
      "batch_convert",
      "compress_video",
      "merge_videos",
      "strip_audio",
      "trim_video"
    ]
  },
  "cases": [
    {
      "name": "single_step_is_left_untouched",
      "registry": "demo",
      "utterance": "trim clip.mp4 to the first 4 seconds",
      "plan": {
        "plan": [
          {
            "tool": "trim_video",
            "args": {
              "input": "clip.mp4",
              "end": "00:00:04"
            }
          }
        ]
      },
      "expected": {
        "plan": [
          {
            "tool": "trim_video",
            "args": {
              "input": "clip.mp4",
              "end": "00:00:04"
            }
          }
        ]
      }
    },
    {
      "name": "undeclared_intermediate_is_claimed_by_the_producer",
      "registry": "demo",
      "utterance": "trim clip.mp4 to the first 4 seconds then compress it",
      "plan": {
        "plan": [
          {
            "tool": "trim_video",
            "args": {
              "input": "clip.mp4",
              "end": "00:00:04"
            }
          },
          {
            "tool": "compress_video",
            "args": {
              "input": "clip_trimmed.mp4"
            }
          }
        ]
      },
      "expected": {
        "plan": [
          {
            "tool": "trim_video",
            "args": {
              "input": "clip.mp4",
              "end": "00:00:04",
              "output": "clip_trimmed.mp4"
            }
          },
          {
            "tool": "compress_video",
            "args": {
              "input": "clip_trimmed.mp4"
            }
          }
        ]
      }
    },
