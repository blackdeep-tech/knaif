      "fn": "declined_close",
      "color": false,
      "args": {
        "step": 1,
        "steps": 1,
        "summary": "no files written",
        "ms": 900
      },
      "expected": " │\n └─ Stopped · you declined · no files written · total 0.900 s"
    },
    {
