    {
      "name": "codec_extension_on_a_batch_output_is_the_container_extension",
      "_why": "ffmpeg_229#4: a codec written as the output extension ('*.hevc') made ffmpeg pick its raw hevc muxer and fail. The explicit video_codec (h264, the model's own) wins; the extension becomes the container's.",
      "plan": {
        "plan": [
          {
            "tool": "convert_video",
            "args": {
              "inputs": [
                "clip.mp4"
              ],
              "container": "mp4",
              "video_codec": "h264",
              "output": "*.hevc"
            }
          }
        ]
      },
      "expected_commands": [
        [
          "ffmpeg",
          "-y",
          "-i",
          "clip.mp4",
          "-c:v",
          "libx264",
          "-pix_fmt",
          "yuv420p",
          "-c:a",
          "copy",
          "-movflags",
          "+faststart",
          "clip_converted.mp4"
        ]
      ]
    },
    {
      "name": "codec_extension_supplies_the_codec_when_none_is_given",
      "plan": {
        "plan": [
          {
            "tool": "convert_video",
            "args": {
              "inputs": [
                "clip.mp4"
              ],
              "output": "clip_small.h265"
            }
          }
        ]
      },
      "expected_commands": [
        [
          "ffmpeg",
          "-y",
          "-i",
          "clip.mp4",
          "-c:v",
          "libx265",
          "-pix_fmt",
          "yuv420p",
          "-c:a",
          "copy",
          "-movflags",
          "+faststart",
          "clip_small.mp4"
        ]
      ]
    },
    {
      "name": "a_same_folder_pattern_never_writes_over_its_input",
      "_why": "'*.mp4' for clip.mp4 resolved onto the input itself, which ffmpeg refuses. The derived name is used instead.",
      "plan": {
        "plan": [
          {
            "tool": "convert_video",
            "args": {
              "inputs": [
                "clip.mp4"
              ],
              "container": "mp4",
              "output": "*.mp4"
            }
          }
        ]
      },
      "expected_commands": [
        [
          "ffmpeg",
          "-y",
          "-i",
          "clip.mp4",
          "-c",
          "copy",
          "-movflags",
          "+faststart",
          "clip_converted.mp4"
        ]
      ]
    },
    {
      "name": "frames_with_a_zero_length_range",
      "_why": "ffmpeg_161#0: start == end names an instant, not a length, so it does not conflict with a frame count. frames decides how much, start where; the empty -to is not rendered.",
      "plan": {
        "plan": [
          {
            "tool": "trim_video",
            "args": {
              "input": "clip.mp4",
              "start": "00:00:00",
              "end": "00:00:00",
              "frames": 1
            }
          }
        ]
      },
      "expected_commands": [
        [
          "ffmpeg",
          "-y",
          "-ss",
          "00:00:00",
          "-i",
          "clip.mp4",
          "-vframes",
          "1",
          "-c:v",
          "libx264",
          "-crf",
          "23",
          "-preset",
          "medium",
          "-pix_fmt",
          "yuv420p",
          "-c:a",
          "aac",
          "-b:a",
          "128k",
          "-movflags",
          "+faststart",
          "clip_trimmed.mp4"
        ]
      ]
    }
