# Git stores text as LF and normalizes on checkout. Without this, a Windows
# checkout with core.autocrlf=true rewrites shell scripts to CRLF, and a CRLF
# `#!/usr/bin/env bash` line fails under bash on every platform. Pin the ones
# that must stay LF regardless of the checkout's autocrlf setting.
* text=auto

*.sh   text eol=lf
*.bash text eol=lf

# Files that ship INSIDE a release payload must be byte-identical wherever they are staged
# from. `* text=auto` converts these on a Windows checkout, so one tracked licence text was
# staged CRLF on Windows and LF in the Linux container — two sha256 values for one file. The
# backend manifest pins per-file checksums and publishes each file as a release asset, so
# that lands as two different assets claiming the same name on one tag. Enforced by
# `test_backend_payload_manifest.py`.
installers/licenses/** text eol=lf

# Generated website data. Both files are written with newline="\n" by scripts/site_data.py
# and scripts/release_data.py, and their drift guards assert the committed copy is LF
# (test_site_data.py, test_release_data.py). `* text=auto` above hands a Windows checkout
# CRLF, so without this a fresh clone fails those tests and `just site-data` reports drift
# against a file nobody edited.
site/data/*.json text eol=lf

# Notebooks, for the same reason and found the same way. nbstripout and black both rewrite
# a notebook with LF, while `* text=auto` hands a Windows checkout CRLF — so every
# `pre-commit run --all-files` reported the same four notebooks as modified, forever, with
# `git diff --ignore-cr-at-eol` empty. Harmless in CI, where the checkout is already LF,
# but a gate that leaves a contributor's tree dirty is a gate people learn to ignore. That
# matters now that the hooks are a required check (post-v1-ci C5).
*.ipynb text eol=lf

# Windows-native scripts stay CRLF.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets — never normalize.
*.png  binary
*.ico  binary
*.gguf binary
