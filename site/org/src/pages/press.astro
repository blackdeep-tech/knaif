---
// Press kit: what a journalist or editor needs to write about knaif without asking first.
// Images shown here are served from knaif.org itself (nothing is fetched from another site on
// load, as /privacy/ promises); the larger files are links to the repository.
import Base from "../layouts/Base.astro";
import ExplainerVideo from "../components/ExplainerVideo.astro";
import { rel, publishedOn } from "../lib/release";
import { explainerUrl } from "../lib/media";

const REPO = "https://github.com/blackdeep-tech/knaif";
const RAW = `${REPO}/raw/main`;
const CONTACT = "knaif@blackdeep.tech";

const short =
  "knaif is a free, open-source tool that turns a request in plain language into the right " +
  "command and runs it. A small AI model on the user's own computer writes a plan; ordinary " +
  "code checks the plan before anything runs. It handles video, audio and PDF tasks on Windows, " +
  "Linux and macOS.";

const long = [
  "knaif lets people tell command-line tools what they want in plain language. Ask it to " +
    "“resize clip.mp4 to 720p” or “merge contract.pdf and invoice.pdf”, and " +
    "it works out the command and runs it, through FFmpeg for video and audio and through PDF " +
    "tools for documents.",
  "The AI involved is a small model that runs on the user's own computer: there is no account, " +
    "no subscription and no cost per request, and no file or request leaves the machine. The " +
    "model is only allowed to propose a plan. Ordinary, predictable code checks that plan " +
    "against the tools the task allows, and asks before it downloads anything or replaces an " +
    "existing file.",
  `knaif runs on Windows, Linux and macOS. Every release is tested on the program people ` +
    `install, on the files it actually produces. It is made by Blackdeep Technologies and ` +
    `released under the Apache 2.0 licence; version ${rel.version} came out on ${publishedOn}.`,
];
---

<Base
  title="Press kit · knaif"
  description="Descriptions, facts, images and video for writing about knaif, and who to contact."
>
  <section>
    <p class="eyebrow">press</p>
    <h1>Press kit</h1>
    <p class="lede">
      Everything here may be used to write about knaif. If you need something that is not on this
      page, write to <a href={`mailto:${CONTACT}`}>{CONTACT}</a>.
    </p>
  </section>

  <section>
    <p class="eyebrow">in two minutes</p>
    <ExplainerVideo />
  </section>

  <section>
    <p class="eyebrow">short description · about 50 words</p>
    <blockquote>{short}</blockquote>
  </section>

  <section>
    <p class="eyebrow">longer description · about 150 words</p>
    <blockquote>{long.map((p) => <p>{p}</p>)}</blockquote>
  </section>

  <section>
    <p class="eyebrow">facts</p>
    <dl class="facts">
      <dt>Name</dt>
      <dd>knaif, written in lower case and pronounced like <em>knife</em></dd>
      <dt>What it is</dt>
      <dd>
        A command-line tool and a Python library: plain-language requests become checked plans
        that real tools run
      </dd>
      <dt>Made by</dt>
      <dd>Blackdeep Technologies Ltd.</dd>
      <dt>Licence</dt>
      <dd>Apache 2.0, free of charge</dd>
      <dt>Latest version</dt>
      <dd>{rel.version}, released {publishedOn}</dd>
      <dt>Runs on</dt>
      <dd>Windows 10 or later; Linux (Ubuntu 22.04 or later and similar); macOS 12 or later on
        Apple Silicon</dd>
      <dt>The model</dt>
      <dd>
        A fine-tuned 4-billion-parameter model (about 2.5 GB), downloaded once and run on the
        user's own processor or graphics card
      </dd>
      <dt>Skills today</dt>
      <dd>Video and audio (through FFmpeg, which the user installs) and documents (PDF and office
        files)</dd>
      <dt>Links</dt>
      <dd>
        <a href="/">knaif.org</a> · <a href={REPO}>source code</a> ·
        <a href={explainerUrl}>video</a> · <a href="/vs/">compared with paid AI assistants</a>
      </dd>
    </dl>
  </section>

  <section>
    <p class="eyebrow">images</p>
    <img
      class="card"
      src="/press/knaif-card.png"
      width="1280"
      height="640"
      alt="The knaif wordmark, kn[AI]f, above the line: Tell your command-line tools what you want, in plain English."
    />
    <ul class="downloads">
      <li><a href="/press/knaif-card.png" download>Title card</a> (PNG, 1280×640)</li>
      <li><a href={`${RAW}/media/knaif-logo-rect.svg`}>Wordmark</a> (SVG, dark letters on light backgrounds, white on dark) ·
        <a href={`${RAW}/media/logo.png`}>PNG</a> (white letters, for dark backgrounds)</li>
      <li><a href={`${RAW}/media/demo/knaif-tour.gif`}>A real session</a> (animated GIF):
        resize a video, make a GIF, merge two PDFs, a refused delete</li>
      <li><a href={`${RAW}/media/demo/knaif-vs-claude-code.gif`}>Side by side with Claude
        Code</a> (animated GIF): the same three requests on one PC, in real time</li>
    </ul>
    <p class="fine">
      Recordings are real sessions with knaif {rel.version} on Linux and an NVIDIA RTX 5080, with
      the model kept loaded; nothing is sped up. The video's footage is from Pexels; its documents
      are fictional samples.
    </p>
  </section>

  <section>
    <p class="eyebrow">contact</p>
    <p>
      Press and partnership questions: <a href={`mailto:${CONTACT}`}>{CONTACT}</a>. Bugs and
      feedback are best left on <a href={`${REPO}/issues/new/choose`}>GitHub</a>.
    </p>
  </section>
</Base>

<style>
  h1 {
    font-size: var(--step-3);
    margin: 0 0 1rem;
    font-weight: 600;
  }

  .lede {
    font-size: var(--step-1);
    color: var(--muted);
    max-width: 58ch;
    margin: 0;
  }

  section {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  section > p {
    margin: 0;
    max-width: var(--measure);
  }

  blockquote {
    margin: 0;
    padding: 1.1rem 1.35rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    max-width: var(--measure);
  }

  blockquote p {
    margin: 0 0 0.8rem;
  }

  blockquote p:last-child {
    margin: 0;
  }

  .facts {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.55rem 1.5rem;
    margin: 0;
    max-width: var(--measure);
  }

  .facts dt {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    padding-top: 0.15rem;
  }

  .facts dd {
    margin: 0;
  }

  @media (max-width: 36rem) {
    .facts {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }

    .facts dd {
      margin-bottom: 0.6rem;
    }
  }

  .card {
    width: 100%;
    max-width: 40rem;
    height: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .downloads {
    margin: 0;
    padding-left: 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    max-width: var(--measure);
  }

  .fine {
    color: var(--muted);
    font-size: var(--step--1);
  }
</style>
