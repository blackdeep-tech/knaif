---
// The kn[AI]f wordmark, as inline SVG.
//
// NOT an <img> of media/knaif-logo-rect.svg. That file carries its own
// `@media (prefers-color-scheme: dark)` block, which answers to the OS and cannot see our
// `data-theme` attribute — so on a light-OS machine with the site toggled to dark, its
// letterforms stay near-black and the wordmark disappears into the header.
//
// Inline with `currentColor` for the letterforms, the brand coral stays fixed for [AI].
// The mark then follows the token system in both themes and both toggle directions.
interface Props {
  height?: string;
  class?: string;
}
const { height = "1.75rem", class: className } = Astro.props;
---

