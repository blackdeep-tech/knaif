# Linux CUDA *payload* build environment for knaif.
#
# WHAT THIS IS FOR. The same argument that produced installers/linux/Dockerfile: a published
# artifact must not inherit its runtime floor from whoever happened to build it. That applies to the
# CUDA payload too — arguably more, because a backend that fails to `dlopen` presents to the user as
# "CUDA didn't work", which is the least debuggable outcome available.
#
# WHY IT IS A SEPARATE IMAGE. The release image deliberately has NO CUDA toolkit: it would add 3-5 GB
# to serve an artifact that image does not produce. That file names this one as the fix, and this is
# it. Contributors need neither.
#
#   docker build -t knaif-linux-cuda-build -f installers/linux/Dockerfile.cuda installers/linux/
#   just package-linux --kind=cuda
#
# ---------------------------------------------------------------------------------------------
# THE TWO FLOORS MUST NOT DRIFT.
# ---------------------------------------------------------------------------------------------
# The payload is `dlopen`ed by the exe from the release image, in one process. If this image had a
# newer glibc, the payload would fail to load on exactly the older systems the release image exists
# to support — and it would fail there and nowhere else, so no amount of local testing would show
# it. So: same Ubuntu release (22.04 / glibc 2.35), same apt snapshot, same Rust pin.
#
# `test_linux_build_images.py` asserts these ARGs match the release Dockerfile's, because "keep them
# in step" is not a thing a comment can enforce.
# ---------------------------------------------------------------------------------------------

# NVIDIA's devel image supplies nvcc, the CUDA headers, cuobjdump, and the redistributable libraries
# package.sh stages into the payload. It is Ubuntu 22.04-based, so the glibc floor matches the
# release image by construction rather than by coincidence.
#
# Pinned by digest as well as tag, matching the release image's `ubuntu:22.04@sha256:…` form. The
# tag stays for readability; the digest is what actually resolves, so two builds of this file cannot
# silently differ. Bump both together, deliberately, in their own commit.
#
# TAG SHAPE, CONFIRMED 2026-07-30. NVIDIA publishes three-component versions only — there is no
# `13.3-devel-ubuntu22.04` alias, and asking for one fails with `no such manifest`. Any prose that
# names a two-component CUDA tag is describing something that does not exist.
#
# THE FLOOR QUESTION IS CLOSED, which this file previously left open: CUDA 13 did drop several older
# distributions, but 22.04 is NOT among them. `13.3.0-devel-ubuntu22.04` and `13.3.1-devel-ubuntu22.04`
# are both published, so the payload's glibc floor matches the release image by construction and
# nothing has to be reopened or worked around.
#
# 13.3.1 exists and is newer. Staying on 13.3.0 is deliberate: it is the version this file already
# declared, docs record the toolkit only as "13.3", and moving the toolkit under a payload the
# Windows half was built against is a decision to take on its own evidence, not a side effect of
# adding a digest.
ARG CUDA_BASE=nvidia/cuda:13.3.0-devel-ubuntu22.04@sha256:e7cb11515d3931675b57eb26c5e70055e702a4d51320c60ebcd899380ee3c7d5
FROM ${CUDA_BASE}

# Kept in step with installers/linux/Dockerfile — see the header. Asserted by a test.
ARG APT_SNAPSHOT=20260727T000000Z
ARG RUST_VERSION=1.96.0

ENV DEBIAN_FRONTEND=noninteractive
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# --- 1a. Bootstrap TLS before apt can reach the snapshot ---------------------------------------
# snapshot.ubuntu.com is HTTPS-only and the base image may carry no CA bundle; apt bootstraps over
# the signed http archive. Same reasoning as the release image, same two-pass structure.
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates

# --- 1b. Pin apt to the SAME snapshot as the release image, then install build deps -------------
#
# NVIDIA's image ships its own /etc/apt/sources.list.d entries for the CUDA repo; those are left
# alone (the toolkit is already installed) and only the Ubuntu archive is repointed at the snapshot.
#
# NO VULKAN HERE. The payload is `ggml-cuda` plus NVIDIA's redistributables and nothing else, so the
# ~1 GB of LunarG packages the release image needs would be dead weight. This is also why the two
# images cannot simply be one.
RUN set -eux; \
    printf 'deb https://snapshot.ubuntu.com/ubuntu/%s jammy main restricted universe multiverse\n\
deb https://snapshot.ubuntu.com/ubuntu/%s jammy-updates main restricted universe multiverse\n\
deb https://snapshot.ubuntu.com/ubuntu/%s jammy-security main restricted universe multiverse\n' \
      "$APT_SNAPSHOT" "$APT_SNAPSHOT" "$APT_SNAPSHOT" > /etc/apt/sources.list; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
      build-essential pkg-config cmake ninja-build patchelf \
      libclang-dev \
      binutils file git curl ca-certificates python3; \
    rm -rf /var/lib/apt/lists/*
# binutils + file are for the ELF dependency audit (scripts/check_elf_deps.py over the staged
# payload), not for the build. patchelf sets the $ORIGIN RPATH so the redist libs resolve from
# beside libggml-cuda.so with no LD_LIBRARY_PATH games.

# --- 2. Rust, at the version the workspace pins ------------------------------------------------
ENV RUSTUP_HOME=/usr/local/rustup CARGO_HOME=/usr/local/cargo PATH=/usr/local/cargo/bin:$PATH
RUN set -eux; \
    curl -fsSL https://sh.rustup.rs | sh -s -- \
      -y --no-modify-path --profile minimal \
      --default-toolchain "${RUST_VERSION}" \
      --component rustfmt --component clippy; \
    chmod -R a+w "$CARGO_HOME" "$RUSTUP_HOME"; \
    rustc --version; cargo --version

# CUDA_PATH is what installers/package.sh reads to locate the redistributable libraries and
# cuobjdump. NVIDIA's images set CUDA_HOME but not this.
ENV CUDA_PATH=/usr/local/cuda

WORKDIR /src
